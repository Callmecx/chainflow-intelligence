# 可选；复制为 .env 后只由 scripts/windows/start.ps1 在当前进程加载。
# 使用 cargo run 时需自行设置进程环境变量。不要把 .env 提交到 Git。
RUST_LOG=info
# 规则配置为一个完整 JSON 行；未指定的键使用默认值。金额单位 USD、时长单位秒。
# CHAINFLOW_RULES_JSON={"min_liquidity_usd":3000,"min_market_cap_usd":5000,"max_market_cap_usd":200000,"max_pool_age_hours":4,"observation_ttl_seconds":7200,"confirmation_delay_seconds":360,"cooldown_seconds":900,"liquidity_drop_pct":30,"drawdown_pct":20,"max_sample_gap_seconds":300}
# Telegram 本版本未接入；不要填写 BOT_TOKEN、CHAT_ID 或任何钱包私钥。
